# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Vinylflix
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars!
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL="file:./dev.db"

# YouTube Data API / OAuth2
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/v1/youtube/oauth/callback
YOUTUBE_API_KEY=your_youtube_api_key

# Payment Gateway (Mock, Paystack, Flutterwave, Stripe)
PAYMENT_PROVIDER=MOCK
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_PUBLIC_KEY=your_payment_public_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Currency & Business Config Defaults
DEFAULT_CURRENCY=NGN
DEFAULT_MEMBERSHIP_PRICE=3000
DEFAULT_CONDITIONAL_REWARD=10000
DEFAULT_REFERRAL_REQUIREMENT=10
DEFAULT_MIN_WITHDRAWAL_AMOUNT=2000
DEFAULT_MIN_WATCH_DURATION=30
DEFAULT_WATCH_REWARD_AMOUNT=5

# Email / SMTP Configuration (Zoho SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@vinylflix.com
SMTP_PASS=your_email_password_here
SMTP_FROM="Vinylflix" <noreply@vinylflix.com>
