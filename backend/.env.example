# ==========================================
# Vinylflix Backend Environment Variables
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Vinylflix
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Security / Authentication
JWT_SECRET=your_jwt_secret_minimum_32_characters_long!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars!
JWT_REFRESH_EXPIRES_IN=30d

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for production on Render/Supabase/Neon:
# DATABASE_URL="postgresql://user:password@host:5432/vinylflix?schema=public"

# YouTube Data API v3 / Google OAuth2
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/v1/youtube/oauth/callback
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Payment Gateway (PAYSTACK | MOCK)
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYMENT_WEBHOOK_SECRET=your_paystack_webhook_secret_signature

# Currency & Business Defaults
DEFAULT_CURRENCY=NGN
DEFAULT_MEMBERSHIP_PRICE=3000
DEFAULT_CONDITIONAL_REWARD=10000
DEFAULT_REFERRAL_REQUIREMENT=10
DEFAULT_MIN_WITHDRAWAL_AMOUNT=2000
DEFAULT_MIN_WATCH_DURATION=30
DEFAULT_WATCH_REWARD_AMOUNT=5
PLATFORM_FEE_PERCENT=5.0
